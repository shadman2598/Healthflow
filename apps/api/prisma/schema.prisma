generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  PATIENT
  RECEPTIONIST
  DOCTOR
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULE_REQUESTED
  MISSED
}

enum AppointmentCategory {
  CHECKUP
  FOLLOW_UP
  MEDICATION
  LAB_REVIEW
  URGENT
  CONSULTATION
  OTHER
}

enum ReminderChannel {
  EMAIL
  SMS
  IN_APP
}

enum ReminderFrequency {
  DAY_BEFORE
  WEEKLY
  EVERY_DAY
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum ReminderLogStatus {
  PENDING
  SENT
  FAILED
}

enum MessageThreadStatus {
  UNREAD
  READ
  PENDING
  RESOLVED
  ARCHIVED
}

enum MessagePriority {
  NORMAL
  HIGH
}

enum AuditAction {
  LOGIN
  LOGOUT
  PATIENT_VIEWED
  PATIENT_CREATED
  PATIENT_UPDATED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_DELETED
  MESSAGE_SENT
  MESSAGE_READ
  REMINDER_CREATED
  REMINDER_SENT
  ROLE_CHANGED
  HEALTHCARE_NUMBER_REVEALED
  STAFF_INVITE_USED
  DATA_EXPORTED
  ANALYTICS_EVENT
}

// Legacy reminder rules engine
model ReminderRule {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  offsetMinutes  Int
  channel        ReminderChannel @default(EMAIL)
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reminderLogs ReminderLog[]

  @@unique([organizationId, name])
  @@index([organizationId, enabled])
}

model ReminderLog {
  id                String            @id @default(cuid())
  organizationId    String
  appointmentId     String
  patientId         String
  ruleId            String?
  channel           ReminderChannel   @default(EMAIL)
  /// Dedup key: "once" for one-shot rules, "day:YYYY-MM-DD" / "week:YYYY-Www" for recurring prefs.
  occurrenceKey     String            @default("once")
  providerMessageId String?
  status            ReminderLogStatus @default(PENDING)
  error             String?
  sentAt            DateTime?
  createdAt         DateTime          @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rule         ReminderRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, ruleId, channel, occurrenceKey])
  @@index([appointmentId, createdAt])
  @@index([patientId, createdAt])
  @@index([organizationId, createdAt])
}

// ─── Core models ─────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  patients       Patient[]
  patientProfiles PatientProfile[]
  doctorProfiles DoctorProfile[]
  staffProfiles  StaffProfile[]
  appointments   Appointment[]
  reminderRules  ReminderRule[]
  reminderLogs   ReminderLog[]
  messageThreads MessageThread[]
  reminders      Reminder[]
  auditLogs      AuditLog[]
  roleInvites    RoleInvite[]

  @@unique([name])
  @@map("Clinic")
}

model User {
  id               String    @id @default(cuid())
  organizationId   String
  email            String    @unique
  passwordHash     String
  role             UserRole  @default(RECEPTIONIST)
  isActive         Boolean   @default(true)
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  lastLoginAt      DateTime?
  privacyConsentAt DateTime?
  createdAt        DateTime  @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  staffProfile   StaffProfile?
  sentMessages   Message[]       @relation("MessageSender")
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@index([organizationId])
  @@index([role])
}

model PatientProfile {
  id                String    @id @default(cuid())
  userId            String?   @unique
  organizationId    String
  firstName         String
  lastName          String
  email             String
  phone             String
  healthcareNumber  String
  dateOfBirth       DateTime?
  heightCm          Float?
  weightKg          Float?
  address           String?
  internalNotes     String?
  assignedDoctorId  String?
  isRegularPatient  Boolean   @default(false)
  reminderPrefEmail Boolean   @default(true)
  reminderPrefSms   Boolean   @default(false)
  reminderPrefApp   Boolean   @default(true)
  /// How often to remind before an upcoming appointment.
  reminderFrequency ReminderFrequency @default(DAY_BEFORE)
  /// Quiet hours (local clinic clock, 0–23). Null = no quiet hours.
  quietHoursStart   Int?
  quietHoursEnd     Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord Patient?
  assignedDoctor DoctorProfile? @relation(fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  messageThreads MessageThread[]
  reminders      Reminder[]

  @@unique([organizationId, healthcareNumber])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([lastName, firstName])
}

model DoctorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  firstName      String
  lastName       String
  specialty      String?
  createdAt      DateTime @default(now())

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedPatients  PatientProfile[]
  appointments      Appointment[]    @relation("AppointmentDoctor")
  assignedThreads   MessageThread[]  @relation("ThreadAssignedDoctor")

  @@index([organizationId])
}

model StaffProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  firstName      String
  lastName       String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Patient record used by reminder engine (links to profile)
model Patient {
  id             String   @id @default(cuid())
  organizationId String
  profileId      String?  @unique
  firstName      String
  lastName       String
  email          String
  phone          String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      PatientProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  reminderLogs ReminderLog[]

  @@index([organizationId])
}

model Appointment {
  id              String              @id @default(cuid())
  organizationId  String
  patientId       String
  profileId       String?
  doctorId        String?
  scheduledAt     DateTime
  /// Planned duration for conflict detection (default 30 minutes).
  durationMinutes Int                 @default(30)
  reason          String?
  patientNotes    String?
  staffNotes      String?
  category        AppointmentCategory @default(CHECKUP)
  status          AppointmentStatus   @default(SCHEDULED)
  checkedInAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  profile      PatientProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  doctor       DoctorProfile? @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  reminderLogs ReminderLog[]
  reminders    Reminder[]

  @@index([scheduledAt])
  @@index([organizationId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([profileId])
  @@index([doctorId])
  @@index([status])
}

model MessageThread {
  id               String              @id @default(cuid())
  organizationId   String
  patientProfileId String
  subject          String
  status           MessageThreadStatus @default(UNREAD)
  priority         MessagePriority     @default(NORMAL)
  assignedDoctorId String?
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  assignedDoctor DoctorProfile? @relation("ThreadAssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([organizationId, status])
  @@index([patientProfileId])
}

model Message {
  id         String    @id @default(cuid())
  threadId   String
  senderId   String
  body       String
  isInternal Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Reminder {
  id             String          @id @default(cuid())
  organizationId String
  appointmentId  String
  profileId      String
  offsetMinutes  Int
  channel        ReminderChannel @default(EMAIL)
  status         ReminderStatus  @default(SCHEDULED)
  dailyUntilAppt Boolean         @default(false)
  sentAt         DateTime?
  error          String?
  createdAt      DateTime        @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  profile      PatientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([organizationId, status])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String?
  actorRole      UserRole?
  action         AuditAction
  targetType     String?
  targetId       String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
}

model RoleInvite {
  id             String    @id @default(cuid())
  organizationId String
  code           String    @unique
  role           UserRole
  email          String?
  usedAt         DateTime?
  usedByUserId   String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, role])
}

model ResourceSearch {
  id         String   @id @default(cuid())
  userId     String?
  postalCode String
  category   String
  results    Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
