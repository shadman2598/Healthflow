generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum UserRole {
  PATIENT
  RECEPTIONIST
  DOCTOR
  NURSE
  BILLING
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULE_REQUESTED
  MISSED
}

enum AppointmentCategory {
  CHECKUP
  FOLLOW_UP
  MEDICATION
  LAB_REVIEW
  URGENT
  CONSULTATION
  OTHER
}

enum ReminderChannel {
  EMAIL
  SMS
  IN_APP
}

enum ReminderFrequency {
  DAY_BEFORE
  WEEKLY
  EVERY_DAY
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum ReminderLogStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationEventStatus {
  SUPPRESSED
  QUEUED
  DELIVERED
  FAILED
  OPENED
  ACTED
  IGNORED
  DISMISSED
}

enum NotificationKind {
  APPOINTMENT_REMINDER
  INTAKE_REMINDER
  MEDICATION_REMINDER
  RESULT_NOTIFICATION
  FOLLOW_UP_REMINDER
  ADMINISTRATIVE_REQUEST
  CLINICIAN_MESSAGE
}

enum NotificationUrgency {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum AiArtifactStatus {
  DRAFT
  PENDING_REVIEW
  REVIEWED
  REJECTED
  BLOCKED
  FAILED
}

enum AiRiskTier {
  LOW_RISK_ADMINISTRATIVE
  CLINICAL_ASSISTANCE
  HIGH_RISK_CLINICAL
}

enum MessageThreadStatus {
  UNREAD
  READ
  PENDING
  RESOLVED
  ARCHIVED
}

enum MessagePriority {
  NORMAL
  HIGH
}

enum AuditAction {
  LOGIN
  LOGOUT
  PATIENT_VIEWED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_DELETED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_DELETED
  MESSAGE_SENT
  MESSAGE_READ
  REMINDER_CREATED
  REMINDER_SENT
  ROLE_CHANGED
  PERMISSION_CHANGED
  HEALTHCARE_NUMBER_REVEALED
  STAFF_INVITE_USED
  STAFF_INVITE_CREATED
  STAFF_CREATED
  DATA_EXPORTED
  DATA_SHARED
  ANALYTICS_EVENT
  AI_GENERATED
  AI_REVIEWED
  AI_BLOCKED
  AI_FAILED
  NEXT_ACTION_DISMISSED
  NEXT_ACTION_RESTORED
  NEXT_ACTION_COMPLETED
  CLINICAL_ORDER_ATTEMPTED
  PRESCRIPTION_BLOCKED
  ADMIN_ACTION
  SCHEDULE_UPDATED
}

// Legacy reminder rules engine
model ReminderRule {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  offsetMinutes  Int
  channel        ReminderChannel @default(EMAIL)
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reminderLogs ReminderLog[]

  @@unique([organizationId, name])
  @@index([organizationId, enabled])
}

model ReminderLog {
  id                String            @id @default(cuid())
  organizationId    String
  appointmentId     String
  patientId         String
  ruleId            String?
  channel           ReminderChannel   @default(EMAIL)
  /// Dedup key: "once" for one-shot rules, "day:YYYY-MM-DD" / "week:YYYY-Www" for recurring prefs.
  occurrenceKey     String            @default("once")
  providerMessageId String?
  status            ReminderLogStatus @default(PENDING)
  error             String?
  sentAt            DateTime?
  createdAt         DateTime          @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rule         ReminderRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, ruleId, channel, occurrenceKey])
  @@index([appointmentId, createdAt])
  @@index([patientId, createdAt])
  @@index([organizationId, createdAt])
}

// ─── Core models ─────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  patients       Patient[]
  patientProfiles PatientProfile[]
  doctorProfiles DoctorProfile[]
  staffProfiles  StaffProfile[]
  appointments   Appointment[]
  reminderRules  ReminderRule[]
  reminderLogs   ReminderLog[]
  messageThreads MessageThread[]
  reminders      Reminder[]
  auditLogs      AuditLog[]
  roleInvites    RoleInvite[]
  providerAvailabilities ProviderAvailability[]
  scheduleBlocks ScheduleBlock[]
  waitlistEntries WaitlistEntry[]
  bookingIdempotencies BookingIdempotency[]
  notificationEvents NotificationEvent[]
  aiArtifacts        AiArtifact[]
  nextActionOverrides NextActionOverride[]

  @@unique([name])
  @@map("Clinic")
}

model User {
  id               String    @id @default(cuid())
  organizationId   String
  email            String    @unique
  passwordHash     String
  role             UserRole  @default(RECEPTIONIST)
  isActive         Boolean   @default(true)
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  lastLoginAt      DateTime?
  privacyConsentAt DateTime?
  createdAt        DateTime  @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  staffProfile   StaffProfile?
  sentMessages   Message[]       @relation("MessageSender")
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@index([organizationId])
  @@index([role])
}

model PatientProfile {
  id                String    @id @default(cuid())
  userId            String?   @unique
  organizationId    String
  firstName         String
  lastName          String
  email             String
  phone             String
  healthcareNumber  String
  dateOfBirth       DateTime?
  heightCm          Float?
  weightKg          Float?
  address           String?
  internalNotes     String?
  assignedDoctorId  String?
  isRegularPatient  Boolean   @default(false)
  reminderPrefEmail Boolean   @default(true)
  reminderPrefSms   Boolean   @default(false)
  reminderPrefApp   Boolean   @default(true)
  /// How often to remind before an upcoming appointment.
  reminderFrequency ReminderFrequency @default(DAY_BEFORE)
  /// Quiet hours (local clinic clock, 0–23). Null = no quiet hours.
  quietHoursStart   Int?
  quietHoursEnd     Int?
  /// Hard opt-out of non-critical notifications.
  notificationsOptOut Boolean @default(false)
  /// Prefer only notifications that require a patient action.
  notificationsActionOnly Boolean @default(false)
  notificationLocale String @default("en-CA")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientRecord Patient?
  assignedDoctor DoctorProfile? @relation(fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  messageThreads MessageThread[]
  reminders      Reminder[]
  waitlistEntries WaitlistEntry[]
  notificationEvents NotificationEvent[]

  @@unique([organizationId, healthcareNumber])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([lastName, firstName])
}

model DoctorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  firstName      String
  lastName       String
  specialty      String?
  createdAt      DateTime @default(now())

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedPatients  PatientProfile[]
  appointments      Appointment[]    @relation("AppointmentDoctor")
  assignedThreads   MessageThread[]  @relation("ThreadAssignedDoctor")
  availabilities    ProviderAvailability[]
  scheduleBlocks    ScheduleBlock[]
  waitlistEntries   WaitlistEntry[]

  @@index([organizationId])
}

model StaffProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  firstName      String
  lastName       String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Patient record used by reminder engine (links to profile)
model Patient {
  id             String   @id @default(cuid())
  organizationId String
  profileId      String?  @unique
  firstName      String
  lastName       String
  email          String
  phone          String
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      PatientProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  reminderLogs ReminderLog[]

  @@index([organizationId])
}

model Appointment {
  id              String              @id @default(cuid())
  organizationId  String
  patientId       String
  profileId       String?
  doctorId        String?
  scheduledAt     DateTime
  /// Planned duration for conflict detection (default 30 minutes).
  durationMinutes Int                 @default(30)
  bufferBeforeMinutes Int             @default(0)
  bufferAfterMinutes  Int             @default(0)
  location        String              @default("main")
  allowDoubleBook Boolean             @default(false)
  /// External scheduler correlation id (Epic/Cerner/etc.).
  externalSyncId  String?
  reason          String?
  patientNotes    String?
  staffNotes      String?
  category        AppointmentCategory @default(CHECKUP)
  status          AppointmentStatus   @default(SCHEDULED)
  checkedInAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  profile      PatientProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  doctor       DoctorProfile? @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  reminderLogs ReminderLog[]
  reminders    Reminder[]

  @@index([scheduledAt])
  @@index([organizationId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([profileId])
  @@index([doctorId, scheduledAt])
  @@index([status])
  @@index([externalSyncId])
}

/// Recurring weekly provider availability (clinic-local clock).
model ProviderAvailability {
  id                  String   @id @default(cuid())
  organizationId      String
  doctorId            String
  dayOfWeek           Int
  startMinute         Int
  endMinute           Int
  location            String   @default("main")
  bufferBeforeMinutes Int      @default(0)
  bufferAfterMinutes  Int      @default(5)
  allowDoubleBook     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([organizationId, doctorId])
  @@index([doctorId, dayOfWeek])
}

/// One-off blocked times (PTO, meetings, room closure).
model ScheduleBlock {
  id             String   @id @default(cuid())
  organizationId String
  doctorId       String?
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
  @@index([doctorId, startsAt])
}

enum WaitlistStatus {
  OPEN
  OFFERED
  BOOKED
  CANCELLED
  EXPIRED
}

model WaitlistEntry {
  id             String             @id @default(cuid())
  organizationId String
  profileId      String
  doctorId       String?
  category       AppointmentCategory?
  preferredFrom  DateTime
  preferredTo    DateTime
  notes          String?
  status         WaitlistStatus     @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      PatientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([doctorId, status])
  @@index([profileId])
}

/// Idempotent booking keys — prevent double-submit race creating two appointments.
model BookingIdempotency {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  requestHash    String
  appointmentId  String?
  responseJson   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([expiresAt])
}

/// Intelligent notifications — usefulness over volume (Prompt 39).
model NotificationEvent {
  id                   String                  @id @default(cuid())
  organizationId       String
  profileId            String?
  kind                 NotificationKind
  urgency              NotificationUrgency     @default(NORMAL)
  requiresAction       Boolean                 @default(true)
  channel              ReminderChannel
  locale               String                  @default("en-CA")
  title                String
  body                 String
  actionHref           String?
  actionLabel          String?
  status               NotificationEventStatus @default(QUEUED)
  suppressReason       String?
  sourceType           String?
  sourceId             String?
  retryCount           Int                     @default(0)
  maxRetries           Int                     @default(2)
  escalateAfterMinutes Int?
  parentEventId        String?
  deliveredAt          DateTime?
  openedAt             DateTime?
  actedAt              DateTime?
  ignoredAt            DateTime?
  dismissedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      PatientProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([profileId, createdAt])
  @@index([sourceType, sourceId])
  @@index([status, deliveredAt])
}

/// AI safety artifacts — drafts only until human review (Prompt 40).
model AiArtifact {
  id                   String           @id @default(cuid())
  organizationId       String
  capabilityId         String
  tier                 AiRiskTier
  status               AiArtifactStatus @default(DRAFT)
  title                String
  content              String
  sourcesJson          Json
  confidence           Float?
  uncertaintyNote      String?
  modelId              String
  promptVersion        String
  artifactVersion      Int              @default(1)
  humanReviewRequired  Boolean          @default(true)
  reviewedByUserId     String?
  reviewedAt           DateTime?
  reviewNotes          String?
  phiRedacted          Boolean          @default(true)
  inputHash            String?
  failureCode          String?
  failureMessage       String?
  disclaimer           String
  createdByUserId      String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, capabilityId])
  @@index([createdByUserId])
}

enum NextActionOverrideStatus {
  DISMISSED
  ACCEPTED
  COMPLETED
}

/// Reversible NEXT_ACTION decisions — engine recomputes; overrides are auditable (Prompt 41).
model NextActionOverride {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  auditKey       String
  status         NextActionOverrideStatus
  reason         String?
  snapshotJson   Json?
  createdAt      DateTime                 @default(now())
  reversedAt     DateTime?
  reversedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, auditKey])
  @@index([organizationId, userId, status])
}

model MessageThread {
  id               String              @id @default(cuid())
  organizationId   String
  patientProfileId String
  subject          String
  status           MessageThreadStatus @default(UNREAD)
  priority         MessagePriority     @default(NORMAL)
  assignedDoctorId String?
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  assignedDoctor DoctorProfile? @relation("ThreadAssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([organizationId, status])
  @@index([patientProfileId])
}

model Message {
  id         String    @id @default(cuid())
  threadId   String
  senderId   String
  body       String
  isInternal Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Reminder {
  id             String          @id @default(cuid())
  organizationId String
  appointmentId  String
  profileId      String
  offsetMinutes  Int
  channel        ReminderChannel @default(EMAIL)
  status         ReminderStatus  @default(SCHEDULED)
  dailyUntilAppt Boolean         @default(false)
  sentAt         DateTime?
  error          String?
  createdAt      DateTime        @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  profile      PatientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([organizationId, status])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String?
  actorRole      UserRole?
  action         AuditAction
  targetType     String?
  targetId       String?
  /// Origin of the write: api route, worker, system, interop, etc.
  source         String      @default("api")
  ipAddress      String?
  metadata       Json?
  /// Immutable creation time — never updated by application APIs.
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([organizationId, action, createdAt])
}

model RoleInvite {
  id             String    @id @default(cuid())
  organizationId String
  code           String    @unique
  role           UserRole
  email          String?
  usedAt         DateTime?
  usedByUserId   String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, role])
}

model ResourceSearch {
  id         String   @id @default(cuid())
  userId     String?
  postalCode String
  category   String
  results    Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
