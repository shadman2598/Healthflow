# Local Next.js talks to the API via same-origin rewrite:
#   browser → /api/backend/* → Express (API_PROXY_ORIGIN, default http://127.0.0.1:4000)
# Leave NEXT_PUBLIC_API_URL unset for local clinic login (cookies stay same-origin).

# Optional rewrite destination (server-side only):
# API_PROXY_ORIGIN=http://127.0.0.1:4000

# --- GitHub Pages / `npm run preview:pages` only ---
# Static export has no Next rewrite. Set these when building for Pages if you host an API:
# NEXT_PUBLIC_GITHUB_PAGES=true
# NEXT_PUBLIC_API_URL=https://your-api.example.com
